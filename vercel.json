{
  "buildCommand": "npm run build",
  "devCommand": "npm run start",
  "installCommand": "npm install",
  "framework": "create-react-app",

  "build": {
    "env": {
      "CI": "false",
      "REACT_APP_API_BASE_URL": "https://client-portfolio-backend.vercel.app"
    }
  },

  "env": {
    "CI": "false",
    "REACT_APP_API_BASE_URL": "https://client-portfolio-backend.vercel.app"
  },

  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://client-portfolio-backend.vercel.app/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],

  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.minuri.me"
        }
      ],
      "destination": "https://minuri.me/$1",
      "permanent": true
    }
  ],

  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/ads.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    }
  ]
}
